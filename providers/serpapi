import fetch from "node-fetch";

/**
 * SerpApi provider
 * ----------------
 * This file is an implementation detail.
 * Faircher tools call THIS file — not SerpApi directly.
 */

const SERPAPI_BASE_URL = "https://serpapi.com/search.json";

const SERPAPI_API_KEY = process.env.SERPAPI_API_KEY;
if (!SERPAPI_API_KEY) {
  throw new Error("Missing SERPAPI_API_KEY environment variable");
}

/**
 * Perform a SerpApi search
 *
 * @param {Object} options
 * @param {string} options.query        - Search query
 * @param {string} [options.engine]     - SerpApi engine (default: google)
 * @param {string} [options.location]   - Optional location
 * @param {number} [options.num]        - Number of results
 *
 * @returns {Object} normalized result
 */
export async function serpapiSearch({
  query,
  engine = "google",
  location,
  num = 10
}) {
  if (!query || typeof query !== "string") {
    throw new Error("SerpApi search requires a non-empty `query` string");
  }

  const url = new URL(SERPAPI_BASE_URL);

  url.searchParams.set("q", query);
  url.searchParams.set("engine", engine);
  url.searchParams.set("num", String(num));
  url.searchParams.set("api_key", SERPAPI_API_KEY);

  if (location) {
    url.searchParams.set("location", location);
  }

  const response = await fetch(url.toString(), {
    method: "GET",
    headers: {
      "Accept": "application/json"
    }
  });

  if (!response.ok) {
    const text = await response.text();
    throw new Error(
      `SerpApi request failed (${response.status}): ${text}`
    );
  }

  const data = await response.json();

  return normalizeSerpApiResponse(data);
}

/**
 * Normalize SerpApi response into Faircher format
 */
function normalizeSerpApiResponse(data) {
  return {
    provider: "serpapi",
    query: data.search_parameters?.q ?? null,
    engine: data.search_parameters?.engine ?? null,
    metadata: {
      id: data.search_metadata?.id,
      status: data.search_metadata?.status,
      total_time_taken: data.search_metadata?.total_time_taken
    },
    results: (data.organic_results || []).map(r => ({
      title: r.title,
      link: r.link,
      snippet: r.snippet,
      position: r.position,
      source: r.source
    }))
  };
}
