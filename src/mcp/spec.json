{
  "name": "FairCher",
  "description": "FairCher is an ad intelligence tool that provides transparency into search, display, social, streaming, and broadcast advertising.",
  "tools": [
    {
      "name": "ad_intelligence",
      "description": "Analyze advertising activity for a brand or domain across multiple channels",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string",
            "description": "Brand name or domain (e.g. nike.com, Coca-Cola)"
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["search", "display", "social", "streaming", "broadcast"]
            },
            "description": "Advertising channels to analyze",
            "default": ["search", "display"]
          }
        },
        "required": ["entity"]
      }
    },
    {
      "name": "google_ads.activity_lookup",
      "description": "Looks up advertising activity using the Google Ads Transparency Center.",
      "inputSchema": {
        "type": "object",
        "required": ["domain"],
        "properties": {
          "domain": {
            "type": "string",
            "description": "Brand name or domain (e.g. nike.com, Coca-Cola)"
          },
          "region": {
            "type": "string",
            "description": "Optional region filter (e.g. US, EU)."
          }
        }
      }
    },
    {
      "name": "meta_ads_lookup",
      "description": "Placeholder for Meta Ads detection.",
      "inputSchema": {
        "type": "object",
        "required": ["entity"],
        "properties": {
          "entity": {
            "type": "string",
            "description": "Brand name or domain (e.g. nike.com, Coca-Cola)"
          },
          "region": {
            "type": "string",
            "description": "Optional region filter (e.g. US, EU)."
          }
        }
      }
    },
    {
      "name": "tiktok_ads_lookup",
      "description": "Placeholder for TikTok Ads detection.",
      "inputSchema": {
        "type": "object",
        "required": ["entity"],
        "properties": {
          "entity": {
            "type": "string",
            "description": "Brand name or domain (e.g. nike.com, Coca-Cola)"
          },
          "region": {
            "type": "string",
            "description": "Optional region filter (e.g. US, EU)."
          }
        }
      }
    },
    {
      "name": "linkedin_ads_lookup",
      "description": "Placeholder for LinkedIn Ads detection.",
      "inputSchema": {
        "type": "object",
        "required": ["entity"],
        "properties": {
          "entity": {
            "type": "string",
            "description": "Brand name or domain (e.g. nike.com, Coca-Cola)"
          },
          "region": {
            "type": "string",
            "description": "Optional region filter (e.g. US, EU)."
          }
        }
      }
    }
  ]
}
